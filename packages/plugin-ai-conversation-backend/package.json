{
  "name": "@acarmisc/backstage-plugin-ai-conversation-backend",
  "version": "0.13.0",
  "description": "Backstage backend plugin for LiteLLM RAG chat — streaming proxy + vector store listing.",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "ai-conversation",
    "pluginPackages": [
      "@acarmisc/backstage-plugin-ai-conversation-backend"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acarmisc/backstage-plugin-ai-conversation"
  },
  "homepage": "https://github.com/acarmisc/backstage-plugin-ai-conversation#readme",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.d.ts",
    "migrations",
    "skills"
  ],
  "scripts": {
    "build": "node build.js && tsc -p tsconfig.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "prepack": "npm run build",
    "postpack": ""
  },
  "dependencies": {
    "@acarmisc/backstage-plugin-litellm-backend": "^0.3.4",
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/catalog-model": "^1.7.3",
    "@backstage/config": "^1.3.0",
    "@backstage/integration": "^2.0.0",
    "@backstage/plugin-catalog-node": "^1.16.0",
    "ai": "^7",
    "express": "^4.18.2",
    "yaml": "^2.3.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "jest": "^30.0.0",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "winston": "^3.17.0"
  },
  "configSchema": "config.d.ts"
}

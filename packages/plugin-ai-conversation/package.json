{
  "name": "@acarmisc/backstage-plugin-ai-conversation",
  "version": "0.14.2",
  "description": "Backstage frontend plugin for LiteLLM RAG chat — streaming UI with model/KB/key pickers.",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "ai-conversation",
    "pluginPackages": [
      "@acarmisc/backstage-plugin-ai-conversation"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acarmisc/backstage-plugin-ai-conversation"
  },
  "homepage": "https://github.com/acarmisc/backstage-plugin-ai-conversation#readme",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js && tsc -p tsconfig.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "prepack": "npm run build",
    "postpack": ""
  },
  "dependencies": {
    "@acarmisc/backstage-plugin-litellm": "^0.4.0",
    "@ai-sdk/react": "^4",
    "@backstage/core-plugin-api": "^1.12.6",
    "@backstage/frontend-plugin-api": "^0.17.0",
    "@backstage/types": "^1.2.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.16.0",
    "ai": "^7",
    "katex": "^0.16.9",
    "react": "^18.0.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.1",
    "jest": "^30.0.0",
    "jsdom": "^27.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.20.0"
  }
}
